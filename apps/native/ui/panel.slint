// The Pulse panel, drawn to match the `.pulse` rules in
// docs/reference/panel-preview.html. Sizes are CSS px, which are Slint logical px.
import { Palette, AboutSlint } from "std-widgets.slint";

import "../fonts/Inter-400.ttf";
import "../fonts/Inter-500.ttf";
import "../fonts/Inter-600.ttf";
import "../fonts/SpaceGrotesk-700.ttf";

export global Theme {
    // 0 follows Windows, 1 light, 2 dark (PULSE_THEME).
    in property <int> force: 0;
    // The Neutral colour theme: each tile gets its own colour.
    in property <bool> neutral: false;
    // Windows "Animation effects": off means bars and tiles do not move.
    in property <bool> animate: true;
    out property <bool> dark: force == 2 || (force == 0 && Palette.color-scheme == ColorScheme.dark);
    out property <color> bg: dark ? #0d0f0e : #ffffff;
    out property <color> ink: dark ? #f1f4f2 : #0d0f0e;
    out property <color> mute: dark ? #98a19d : #5b625f;
    out property <color> line: dark ? #232926 : #e4e7e5;
    out property <color> soft: dark ? #161a18 : #f2f4f3;
    out property <color> hero-bg: dark ? #12231a : #b8f5d0;
    out property <color> hero-ink: dark ? #b8f5d0 : #0d0f0e;
    out property <color> mint: #b8f5d0;
    out property <color> dot: #2fbf71;
    out property <color> warn: dark ? #ff9b6b : #c2410c;
    out property <color> focus: dark ? #7dd3fc : #2563eb;
    out property <color> track-off: dark ? #3a423e : #c9cfcc;
    out property <color> c-cpu: dark ? #60a5fa : #2563eb;
    out property <color> c-mem: dark ? #a78bfa : #7c3aed;
    out property <color> c-gpu: dark ? #fbbf24 : #d97706;
    out property <color> c-drive: dark ? #2dd4bf : #0d9488;
    out property <color> c-net: dark ? #f472b6 : #db2777;
    out property <duration> motion: animate ? 400ms : 0ms;
}

export struct AppItem {
    // 0 app, 1 WSL, 2 Linux program inside WSL, 3 "Reading apps..." placeholder.
    kind: int,
    letter: string,
    color: color,
    name: string,
    detail: string,
    value: string,
    frac: float,
    icon: image,
    has-icon: bool,
    agent: bool,
    count: string,
    group-end: bool,
}

// A keyboard-focus ring, drawn over a control while it has focus.
component Ring inherits Rectangle {
    in property <bool> active;
    in property <length> radius: 8px;
    visible: root.active;
    border-width: 2px;
    border-color: Theme.focus;
    border-radius: root.radius;
}

// Sizes that both views share with src/view.rs (`row_height` and the compact
// and expanded heights). Kinds: 0 app, 1 WSL, 2 Linux program, 3 reading,
// 4 and 5 the compact view's Linux row (closed, open).
global Metrics {
    pure public function row-h(kind: int, compact: bool) -> length {
        if (compact) {
            return kind == 2 ? 22px : (kind == 3 ? 36px : 29px);
        }
        return kind == 2 ? 24px : (kind == 3 ? 40px : 53px);
    }
}

// Square icon button (view switch, gear, close). 30 px in the expanded view,
// 28 px in the compact one.
component IconBtn inherits Rectangle {
    in property <image> source;
    in property <bool> on: true;
    in property <length> size: 34px;
    // The accessible name (there is no tooltip).
    in property <string> label;
    callback clicked;
    width: root.size;
    height: root.size;
    border-radius: 8px;
    background: ta.has-hover && root.on ? Theme.soft : transparent;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => {
        root.clicked();
    }
    Image {
        width: root.size >= 34px ? 18px : (root.size >= 30px ? 17px : 16px);
        height: self.width;
        source: root.source;
        colorize: ta.has-hover ? Theme.ink : Theme.mute;
    }

    fs := FocusScope {
        enabled: root.on;
        key-pressed(e) => {
            if (e.text == " " || e.text == "\n") {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }

    ta := TouchArea {
        enabled: root.on;
        clicked => {
            root.clicked();
        }
    }

    Ring {
        active: fs.has-focus;
    }
}

component PButton inherits Rectangle {
    in property <string> text;
    in property <bool> primary: false;
    in property <bool> on: true;
    callback clicked;
    height: 32px;
    width: lbl.preferred-width + 28px;
    border-radius: 8px;
    background: root.primary ? (ta.has-hover ? (Theme.neutral ? Theme.ink.with-alpha(0.8) : Theme.hero-bg.brighter(0.15)) : (Theme.neutral ? Theme.ink : Theme.hero-bg)) : (ta.has-hover ? Theme.line : Theme.soft);
    border-width: root.primary ? 0px : 1px;
    border-color: Theme.line;
    lbl := Text {
        text: root.text;
        font-family: "Inter";
        font-size: 13px;
        font-weight: 600;
        color: root.primary ? (Theme.neutral ? Theme.bg : Theme.hero-ink) : Theme.ink;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    fs := FocusScope {
        enabled: root.on;
        key-pressed(e) => {
            if (e.text == " " || e.text == "\n") {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }

    ta := TouchArea {
        enabled: root.on;
        clicked => {
            root.clicked();
        }
    }

    Ring {
        active: fs.has-focus;
    }
}

component PSwitch inherits Rectangle {
    in property <bool> checked;
    in property <bool> on: true;
    callback toggled(bool);
    width: 40px;
    height: 24px;
    border-radius: 12px;
    background: root.checked ? Theme.dot : (ta.has-hover ? Theme.mute : Theme.track-off);
    Rectangle {
        x: root.checked ? 19px : 3px;
        y: 3px;
        width: 18px;
        height: 18px;
        border-radius: 9px;
        background: #ffffff;
        animate x {
            duration: Theme.motion / 2;
        }
    }

    fs := FocusScope {
        enabled: root.on;
        key-pressed(e) => {
            if (e.text == " " || e.text == "\n") {
                root.toggled(!root.checked);
                return accept;
            }
            return reject;
        }
    }

    ta := TouchArea {
        enabled: root.on;
        clicked => {
            root.toggled(!root.checked);
        }
    }

    Ring {
        active: fs.has-focus;
        radius: 12px;
    }
}

// Segmented control, like the reference page's `.seg`.
component Seg inherits Rectangle {
    in property <[string]> labels;
    in property <int> current;
    in property <bool> on: true;
    // The panel's own control: 30 px high with 12.5 px text (Settings keeps 34 px).
    in property <bool> dense: false;
    callback picked(int);
    width: row.preferred-width + 4px;
    height: root.dense ? 30px : 34px;
    background: Theme.soft;
    border-radius: 8px;
    row := HorizontalLayout {
        x: 2px;
        y: 2px;
        height: root.dense ? 26px : 30px;
        for label[i] in root.labels: Rectangle {
            width: measure.preferred-width + (root.dense ? 18px : 20px);
            border-radius: 6px;
            background: i == root.current ? Theme.bg : (ta.has-hover ? Theme.line.with-alpha(0.6) : transparent);
            drop-shadow-blur: i == root.current ? 2px : 0px;
            drop-shadow-offset-y: 1px;
            drop-shadow-color: #0000001f;
            // Sized by the bold text, so the control does not change width.
            measure := Text {
                visible: false;
                text: label;
                font-family: "Inter";
                font-size: root.dense ? 12.5px : 13px;
                font-weight: 600;
            }

            Text {
                text: label;
                font-family: "Inter";
                font-size: root.dense ? 12.5px : 13px;
                font-weight: i == root.current ? 600 : 400;
                color: i == root.current ? Theme.ink : (ta.has-hover ? Theme.ink : Theme.mute);
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            fs := FocusScope {
                enabled: root.on;
                key-pressed(e) => {
                    if (e.text == " " || e.text == "\n") {
                        root.picked(i);
                        return accept;
                    }
                    return reject;
                }
            }

            ta := TouchArea {
                enabled: root.on;
                clicked => {
                    root.picked(i);
                }
            }

            Ring {
                active: fs.has-focus;
                radius: 6px;
            }
        }
    }
}

// A clipped area that scrolls with the mouse wheel and shows a thin scrollbar
// only when its content does not fit.
component Scroll inherits Rectangle {
    in property <length> content-h;
    clip: true;
    fl := Flickable {
        width: root.width;
        height: root.height;
        content-width: root.width;
        content-height: root.content-h;
        @children
    }

    Rectangle {
        visible: root.content-h > root.height + 0.5px;
        x: root.width - 4px;
        width: 3px;
        height: max(24px, root.height * root.height / root.content-h);
        y: (root.height - self.height) * (-fl.content-y / max(1px, root.content-h - root.height));
        border-radius: 2px;
        background: Theme.mute.with-alpha(0.55);
    }
}

// Expanded view: Processor and Memory tiles, "B Tighter" (175 x 118).
component Hero inherits Rectangle {
    in property <string> label;
    in property <string> big;
    in property <string> sub;
    // " · restart?" after the sub line, in the warning colour.
    in property <bool> restart: false;
    in property <string> line;
    in property <string> fill;
    in property <color> ink;
    in property <color> tile-bg;
    // Colour of the sparkline (the text colour unless the Neutral theme sets one).
    in property <color> spark;
    // Neutral: a coloured square before the label.
    in property <bool> square: false;
    in property <bool> outlined: false;
    background: tile-bg;
    border-radius: 14px;
    border-width: root.outlined ? 1px : 0px;
    border-color: Theme.line;
    height: 118px;
    width: 175px;

    if root.square: Rectangle {
        x: 10px;
        y: 13px;
        width: 8px;
        height: 8px;
        border-radius: 2px;
        background: root.spark;
    }

    Text {
        x: root.square ? 24px : 10px;
        y: 8px;
        width: parent.width - 20px - (root.square ? 14px : 0px);
        height: 19px;
        text: root.label;
        font-family: "Inter";
        font-size: 13px;
        font-weight: 600;
        color: root.ink.with-alpha(0.75);
        vertical-alignment: center;
        overflow: elide;
    }

    Text {
        x: 10px;
        y: 29px;
        width: parent.width - 20px;
        height: 29px;
        text: root.big;
        font-family: "Space Grotesk";
        font-size: 28px;
        font-weight: 700;
        letter-spacing: -0.56px;
        color: root.ink;
        vertical-alignment: center;
    }

    Path {
        x: 10px;
        y: 64px;
        width: parent.width - 20px;
        height: 26px;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: 149;
        viewbox-height: 34;
        commands: root.fill;
        fill: root.spark.with-alpha(0.16);
    }

    Path {
        x: 10px;
        y: 64px;
        width: parent.width - 20px;
        height: 26px;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: 149;
        viewbox-height: 34;
        commands: root.line;
        stroke: root.spark;
        stroke-width: 2px;
        stroke-line-join: round;
    }

    sub-t := Text {
        x: 10px;
        y: 92px;
        width: min(self.preferred-width, parent.width - 20px - (root.restart ? restart-t.preferred-width : 0px));
        height: 19px;
        text: root.sub;
        font-family: "Inter";
        font-size: 13px;
        color: root.ink.with-alpha(0.75);
        vertical-alignment: center;
        overflow: elide;
    }

    restart-t := Text {
        visible: root.restart;
        x: 10px + sub-t.width;
        y: 92px;
        height: 19px;
        text: " · restart?";
        font-family: "Inter";
        font-size: 13px;
        font-weight: 600;
        color: Theme.warn;
        vertical-alignment: center;
    }
}

// Compact view: Processor or Memory as a half-width tile with the number and
// a tiny chart (177 x 49).
component MiniTile inherits Rectangle {
    in property <string> label;
    in property <string> big;
    in property <length> big-size: 22px;
    in property <string> line;
    in property <string> fill;
    in property <color> ink;
    in property <color> tile-bg;
    in property <color> spark;
    in property <bool> square: false;
    in property <bool> outlined: false;
    background: tile-bg;
    border-radius: 10px;
    border-width: root.outlined ? 1px : 0px;
    border-color: Theme.line;
    height: 49px;
    width: 177px;
    // The text column is as wide as its wider line; the chart takes the rest.
    property <length> txt-w: max(lab.preferred-width + (root.square ? 12px : 0px), bigt.preferred-width);

    if root.square: Rectangle {
        x: 9px;
        y: 9px;
        width: 8px;
        height: 8px;
        border-radius: 2px;
        background: root.spark;
    }

    lab := Text {
        x: root.square ? 21px : 9px;
        y: 6px;
        height: 14px;
        text: root.label;
        font-family: "Inter";
        font-size: 11.5px;
        font-weight: 600;
        color: root.ink.with-alpha(0.75);
        vertical-alignment: center;
    }

    bigt := Text {
        x: 9px;
        y: 20px;
        height: 23px;
        text: root.big;
        font-family: "Space Grotesk";
        font-size: root.big-size;
        font-weight: 700;
        letter-spacing: -0.2px;
        color: root.ink;
        vertical-alignment: center;
    }

    Path {
        x: 9px + root.txt-w + 8px;
        y: 10px;
        width: max(10px, root.width - 18px - root.txt-w - 8px);
        height: 28px;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: 149;
        viewbox-height: 34;
        commands: root.fill;
        fill: root.spark.with-alpha(0.16);
    }

    Path {
        x: 9px + root.txt-w + 8px;
        y: 10px;
        width: max(10px, root.width - 18px - root.txt-w - 8px);
        height: 28px;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: 149;
        viewbox-height: 34;
        commands: root.line;
        stroke: root.spark;
        stroke-width: 2px;
        stroke-line-join: round;
    }
}

// Expanded view: the bottom tiles (Graphics, Drive, Network), 114 x 83.
component Tile inherits Rectangle {
    in property <string> k;
    in property <string> v;
    in property <string> s;
    in property <bool> bar: true;
    in property <float> frac;
    in property <color> accent;
    // No reading: the value text is smaller so "Not reported" fits.
    in property <bool> small-v: false;
    height: 83px;
    border-radius: 12px;
    background: Theme.soft;

    if Theme.neutral: Rectangle {
        x: 9px;
        y: 12px;
        width: 8px;
        height: 8px;
        border-radius: 2px;
        background: root.accent;
    }

    Text {
        x: Theme.neutral ? 23px : 9px;
        y: 7px;
        width: parent.width - 18px - (Theme.neutral ? 14px : 0px);
        height: 19px;
        text: root.k;
        font-family: "Inter";
        font-size: 13px;
        font-weight: 500;
        color: Theme.mute;
        vertical-alignment: center;
        overflow: elide;
    }

    Text {
        x: 9px;
        y: 26px;
        width: parent.width - 18px;
        height: 19px;
        text: root.v;
        font-family: "Space Grotesk";
        font-size: root.small-v ? 13px : 15.5px;
        font-weight: 700;
        color: Theme.ink;
        vertical-alignment: center;
        overflow: elide;
    }

    Text {
        x: 9px;
        y: 45px;
        width: parent.width - 18px;
        height: 19px;
        text: root.s;
        font-family: "Inter";
        font-size: 13px;
        color: Theme.mute;
        vertical-alignment: center;
        overflow: elide;
    }

    if root.bar: Rectangle {
        x: 9px;
        y: 70px;
        width: parent.width - 18px;
        height: 5px;
        border-radius: 3px;
        background: Theme.line;
        clip: true;
        Rectangle {
            x: 0;
            width: parent.width * root.frac;
            height: parent.height;
            border-radius: 3px;
            background: Theme.neutral ? root.accent : Theme.ink;
            animate width {
                duration: Theme.motion;
                easing: cubic-bezier(0.25, 0.1, 0.25, 1);
            }
        }
    }
}

// Compact view: one small figure of the footer row, "Graphics 13%" or
// "C: 296 GB free": a muted word, the bold figure, more muted words.
component FootFig inherits Rectangle {
    in property <string> pre;
    in property <string> val;
    in property <string> post;
    // A second bold figure (the network's up rate).
    in property <string> val2;
    in property <bool> warn: false;
    // Neutral: a coloured square first, like the other tiles.
    in property <color> accent: transparent;
    in property <bool> square: false;
    width: row.preferred-width;
    height: 17px;
    row := HorizontalLayout {
        spacing: 4px;
        alignment: start;
        if root.square && Theme.neutral: Rectangle {
            width: 7px;
            Rectangle {
                y: 5px;
                width: 7px;
                height: 7px;
                border-radius: 2px;
                background: root.accent;
            }
        }
        if root.pre != "": Text {
            text: root.pre;
            font-family: "Inter";
            font-size: 11.5px;
            color: Theme.mute;
            vertical-alignment: center;
        }
        if root.val != "": Text {
            text: root.val;
            font-family: "Inter";
            font-size: 11.5px;
            font-weight: 600;
            color: root.warn ? Theme.warn : Theme.ink;
            vertical-alignment: center;
        }
        if root.post != "": Text {
            text: root.post;
            font-family: "Inter";
            font-size: 11.5px;
            color: Theme.mute;
            vertical-alignment: center;
        }
        if root.val2 != "": Text {
            text: root.val2;
            font-family: "Inter";
            font-size: 11.5px;
            font-weight: 600;
            color: Theme.ink;
            vertical-alignment: center;
        }
    }
}

// An app's icon: the real icon, or a coloured square with the first letter.
component AppIcon inherits Rectangle {
    in property <AppItem> item;
    // Size of a real icon inside the square.
    in property <length> img: 20px;
    background: root.item.has-icon ? transparent : root.item.color;
    border-radius: root.width / 4;
    if root.item.has-icon: Image {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: root.img;
        height: root.img;
        source: root.item.icon;
        image-fit: contain;
    }
    if !root.item.has-icon: Text {
        text: root.item.letter;
        font-family: "Inter";
        font-size: root.width * 0.46;
        font-weight: 700;
        color: #ffffff;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component AppRow inherits Rectangle {
    in property <AppItem> item;
    in property <bool> last;
    in property <color> bar;
    // The compact view's rows are one line high.
    in property <bool> compact;
    // The compact view's Linux row was clicked (or Space or Enter pressed).
    callback toggled;
    height: Metrics.row-h(root.item.kind, root.compact);

    // Before the first scan of the apps has finished.
    if root.item.kind == 3: Text {
        x: 2px;
        y: 0px;
        width: root.width - 4px;
        height: root.height;
        text: root.item.name;
        font-family: "Inter";
        font-size: 13px;
        color: Theme.mute;
        vertical-alignment: center;
    }

    // Expanded view: apps and the WSL machine, two lines.
    if !root.compact && root.item.kind < 2: Rectangle {
        AppIcon {
            x: 2px;
            y: 14px;
            width: 24px;
            height: 24px;
            item: root.item;
            img: 22px;
        }

        Text {
            x: 36px;
            y: 5px;
            width: root.width - 36px - 2px - val.preferred-width - 10px;
            height: 20px;
            text: root.item.name;
            font-family: "Inter";
            font-size: 13.5px;
            font-weight: 500;
            color: Theme.ink;
            vertical-alignment: center;
            overflow: elide;
        }

        val := Text {
            x: root.width - 2px - self.preferred-width;
            y: 5px;
            height: 20px;
            text: root.item.value;
            font-family: "Inter";
            font-size: 13.5px;
            font-weight: 600;
            color: Theme.ink;
            horizontal-alignment: right;
            vertical-alignment: center;
        }

        Text {
            x: 36px;
            y: 29px;
            width: root.width - 36px - 2px - 90px - 10px;
            height: 19px;
            text: root.item.detail;
            font-family: "Inter";
            font-size: 12.5px;
            color: Theme.mute;
            vertical-alignment: center;
            overflow: elide;
        }

        Rectangle {
            x: root.width - 2px - 90px;
            y: 36px;
            width: 90px;
            height: 5px;
            border-radius: 3px;
            background: Theme.line;
            clip: true;
            Rectangle {
                x: 0;
                width: parent.width * root.item.frac;
                height: parent.height;
                border-radius: 3px;
                background: root.bar;
                animate width {
                    duration: Theme.motion;
                    easing: cubic-bezier(0.25, 0.1, 0.25, 1);
                }
            }
        }

        Rectangle {
            y: 52px;
            height: (root.last || root.item.kind == 1) ? 0px : 1px;
            background: Theme.line;
        }
    }

    // Compact view: an app on one line, name, thin bar, figure. The figure
    // column has one width, so the bars line up.
    if root.compact && root.item.kind == 0: Rectangle {
        AppIcon {
            x: 2px;
            y: 4px;
            width: 20px;
            height: 20px;
            item: root.item;
            img: 18px;
        }

        Text {
            x: 30px;
            y: 5px;
            width: root.width - 2px - 54px - 8px - 56px - 8px - 30px;
            height: 19px;
            text: root.item.name;
            font-family: "Inter";
            font-size: 13px;
            font-weight: 500;
            color: Theme.ink;
            vertical-alignment: center;
            overflow: elide;
        }

        Rectangle {
            x: root.width - 2px - 54px - 8px - 56px;
            y: 12px;
            width: 56px;
            height: 4px;
            border-radius: 2px;
            background: Theme.line;
            clip: true;
            Rectangle {
                x: 0;
                width: parent.width * root.item.frac;
                height: parent.height;
                border-radius: 2px;
                background: root.bar;
                animate width {
                    duration: Theme.motion;
                    easing: cubic-bezier(0.25, 0.1, 0.25, 1);
                }
            }
        }

        Text {
            x: root.width - 2px - 54px;
            y: 5px;
            width: 54px;
            height: 19px;
            text: root.item.value;
            font-family: "Inter";
            font-size: 13px;
            font-weight: 600;
            color: Theme.ink;
            horizontal-alignment: right;
            vertical-alignment: center;
        }

        Rectangle {
            y: 28px;
            height: root.last ? 0px : 1px;
            background: Theme.line;
        }
    }

    // Compact view: the Linux row. With programs inside it is a button that
    // opens and closes the list (chevron on the right); a bare machine is a
    // plain row.
    if root.compact && (root.item.kind == 1 || root.item.kind >= 4): Rectangle {
        property <bool> fold: root.item.kind >= 4;
        property <length> tail: fold ? 26px : 0px;

        Rectangle {
            visible: fold && ta.has-hover;
            y: 1px;
            height: root.height - 2px;
            border-radius: 6px;
            background: Theme.soft;
        }

        AppIcon {
            x: 2px;
            y: 4px;
            width: 20px;
            height: 20px;
            item: root.item;
            img: 18px;
        }

        HorizontalLayout {
            x: 30px;
            y: 5px;
            height: 19px;
            width: root.width - 30px - 2px - tail - val-c.preferred-width - 8px;
            alignment: start;
            spacing: 6px;
            Text {
                text: root.item.name;
                font-family: "Inter";
                font-size: 13px;
                font-weight: 500;
                color: Theme.ink;
                vertical-alignment: center;
                overflow: elide;
                min-width: 0px;
            }

            if root.item.detail != "": Text {
                text: "· " + root.item.detail;
                font-family: "Inter";
                font-size: 12.5px;
                color: Theme.mute;
                vertical-alignment: center;
                overflow: elide;
                min-width: 0px;
            }
        }

        val-c := Text {
            x: root.width - 2px - tail - self.preferred-width;
            y: 5px;
            height: 19px;
            text: root.item.value;
            font-family: "Inter";
            font-size: 13px;
            font-weight: 600;
            color: Theme.ink;
            horizontal-alignment: right;
            vertical-alignment: center;
        }

        if fold: Path {
            x: root.width - 2px - 18px + 2px;
            y: 7px;
            width: 14px;
            height: 14px;
            viewbox-x: 0;
            viewbox-y: 0;
            viewbox-width: 24;
            viewbox-height: 24;
            commands: root.item.kind == 5 ? "M6 15 L12 9 L18 15" : "M6 9 L12 15 L18 9";
            stroke: Theme.mute;
            stroke-width: 1.6px;
            stroke-line-cap: round;
            stroke-line-join: round;
        }

        Rectangle {
            y: 28px;
            height: root.last ? 0px : 1px;
            background: Theme.line;
        }

        fs := FocusScope {
            enabled: fold;
            accessible-role: button;
            accessible-label: root.item.name + ", " + root.item.detail;
            accessible-expandable: true;
            accessible-expanded: root.item.kind == 5;
            accessible-action-default => {
                root.toggled();
            }
            key-pressed(e) => {
                if (e.text == " " || e.text == "\n") {
                    root.toggled();
                    return accept;
                }
                return reject;
            }
        }

        ta := TouchArea {
            enabled: fold;
            clicked => {
                root.toggled();
            }
        }

        Ring {
            active: fold && fs.has-focus;
            radius: 6px;
        }
    }

    // A Linux program inside WSL: indented, smaller.
    if root.item.kind == 2: Rectangle {
        property <length> pad: root.compact ? 4px : 8px;
        property <length> ic: 18px;
        property <length> top: (root.height - self.ic) / 2;
        Rectangle {
            x: parent.pad;
            y: parent.top;
            width: parent.ic;
            height: parent.ic;
            border-radius: 5px;
            background: root.item.color;
            Text {
                text: root.item.letter;
                font-family: "Inter";
                font-size: 10.5px;
                font-weight: 700;
                color: #ffffff;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        HorizontalLayout {
            x: parent.pad + parent.ic + 8px;
            y: parent.top;
            height: parent.ic;
            width: root.width - self.x - 2px - sub-val.preferred-width - 8px;
            alignment: start;
            spacing: 0px;
            Text {
                text: root.item.name;
                font-family: "Inter";
                font-size: 12.5px;
                color: Theme.ink;
                vertical-alignment: center;
                overflow: elide;
                min-width: 0px;
            }

            if root.item.agent: Rectangle {
                width: 6px;
            }
            if root.item.agent: Rectangle {
                width: badge-t.preferred-width + 10px;
                height: 17px;
                y: 0.5px;
                border-radius: 4px;
                background: Theme.neutral ? Theme.c-cpu : Theme.mint;
                badge-t := Text {
                    text: "agent";
                    font-family: "Inter";
                    font-size: 11.5px;
                    font-weight: 600;
                    color: Theme.neutral ? Theme.bg : #0d0f0e;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
            if root.item.count != "": Rectangle {
                width: 5px;
            }
            if root.item.count != "": Text {
                text: root.item.count;
                font-family: "Inter";
                font-size: 12.5px;
                color: Theme.mute;
                vertical-alignment: center;
            }
        }

        sub-val := Text {
            x: root.width - 2px - self.preferred-width;
            y: parent.top;
            height: parent.ic;
            text: root.item.value;
            font-family: "Inter";
            font-size: 12.5px;
            font-weight: 500;
            color: Theme.mute;
            horizontal-alignment: right;
            vertical-alignment: center;
        }

        Rectangle {
            y: root.height - 1px;
            height: (root.item.group-end && !root.compact) ? 1px : 0px;
            background: Theme.line;
        }
    }
}

// One line of the Settings screen: bold name, muted note, a control on the right.
component SRow inherits Rectangle {
    in property <string> name;
    in property <string> note;
    in property <bool> warn: false;
    in property <length> ctl-w: 40px;
    in property <bool> line: true;
    height: 8px + 20px + 1px + note-t.preferred-height + 9px;
    Text {
        x: 0;
        y: 8px;
        width: root.width - root.ctl-w - 12px;
        height: 20px;
        text: root.name;
        font-family: "Inter";
        font-size: 14px;
        font-weight: 600;
        color: Theme.ink;
        vertical-alignment: center;
        overflow: elide;
    }

    note-t := Text {
        x: 0;
        y: 29px;
        width: root.width - root.ctl-w - 12px;
        text: root.note;
        wrap: word-wrap;
        font-family: "Inter";
        font-size: 12.5px;
        color: root.warn ? Theme.warn : Theme.mute;
    }

    HorizontalLayout {
        x: root.width - root.ctl-w;
        y: (root.height - 34px) / 2;
        width: root.ctl-w;
        height: 34px;
        alignment: end;
        @children
    }

    Rectangle {
        y: root.height - 1px;
        height: root.line ? 1px : 0px;
        background: Theme.line;
    }
}

export component PanelWindow inherits Window {
    in property <string> status: "";
    in property <bool> status-warn: false;
    in property <string> cpu-big: "0%";
    in property <string> cpu-sub: "";
    in property <bool> cpu-restart: false;
    in property <string> cpu-line: "";
    in property <string> cpu-fill: "";
    in property <string> mem-big: "0 GB";
    in property <string> mem-sub: "";
    in property <string> mem-line: "";
    in property <string> mem-fill: "";
    in property <[AppItem]> apps;
    in property <string> gpu-big: "";
    in property <bool> gpu-missing: false;
    in property <float> gpu-frac;
    in property <string> drive-big: "";
    in property <string> drive-sub: "";
    in property <float> drive-frac;
    in property <string> net-big: "";
    in property <string> net-sub: "";
    in property <bool> has-battery: false;
    in property <string> bat-big: "";
    in property <string> bat-sub: "";
    in property <float> bat-frac;
    in property <bool> bat-low: false;
    // Footer: the shortcut's key cap (empty when off), the words after it, and the age.
    in property <string> cap: "";
    in property <string> foot: "";
    // Used instead of `foot` when a long key cap leaves it no room.
    in property <string> foot-short: "";
    in property <string> ago: "";
    // The compact view: half-width tiles, one-line rows, one footer row of figures.
    in property <bool> compact: false;
    // The window's height: set by the app for the view, the Linux list, the work
    // area and the Settings sheet (see `panel_height` in src/view.rs).
    in property <length> panel-h: 580px;
    // The footer row's network figures.
    in property <string> net-down: "";
    in property <string> net-up: "";
    // Top apps: false sorts by memory, true by processor.
    in property <bool> sort-cpu: false;
    // The Settings screen.
    in-out property <bool> settings-open: false;
    // The shortcut switch, the field and the line under it. `field-state`: 0 works,
    // 1 switched off (dimmed), 2 waiting for keys, 3 did not register.
    in property <bool> shortcut-on: true;
    in property <string> key-text: "";
    in property <int> field-state: 0;
    in property <string> key-hint: "";
    in property <string> hotkey-note: "";
    in property <bool> hotkey-warn: false;
    in property <bool> keep-open: false;
    in property <bool> autostart: false;
    // The Run value starts another copy of Pulse.
    in property <bool> autostart-other: false;
    // The last attempt to save the settings failed.
    in property <bool> save-failed: false;
    in property <int> refresh: 0;
    in property <string> version: "";
    callback close-clicked;
    callback sort-picked(int);
    callback theme-picked(int);
    callback keep-toggled(bool);
    callback autostart-toggled(bool);
    callback refresh-picked(int);
    callback field-clicked;
    callback shortcut-toggled(bool);
    callback settings-shown;
    callback settings-hidden;
    // The header button: switch between the expanded and the compact view.
    callback view-toggled;
    // The compact view's Linux row: open or close its list.
    callback wsl-toggled;

    // Follow a forced light or dark theme in the standard widgets as well.
    property <int> scheme: Theme.force;
    changed scheme => {
        Palette.color-scheme = root.scheme == 2 ? ColorScheme.dark : (root.scheme == 1 ? ColorScheme.light : Palette.color-scheme);
    }

    title: "Pulse";
    width: 380px;
    height: root.panel-h;
    no-frame: true;
    always-on-top: true;
    background: transparent;
    default-font-family: "Inter";

    // Layout, from the top and from the bottom (the footer and the tiles keep
    // their distance from the bottom edge, the list takes what is between).
    property <length> px: root.compact ? 9px : 11px;
    property <length> ib: root.compact ? 28px : 30px;
    property <length> close-x: root.width - (root.compact ? 7px : 9px) - root.ib;
    property <length> head-y: root.compact ? 100px : 191px;
    property <length> list-y: root.compact ? 134px : 225px;
    property <length> foot-y: root.compact ? root.height - (root.has-battery ? 52px : 33px) : root.height - 35px;
    property <length> tiles-y: root.height - 43px - 83px - (root.has-battery ? 55px : 0px);
    property <length> list-bottom: root.compact ? root.foot-y - 4px : root.tiles-y - 9px;
    property <color> bar: Theme.neutral ? (root.sort-cpu ? Theme.c-cpu : Theme.c-mem) : Theme.ink;

    Rectangle {
        width: parent.width;
        height: parent.height;
        background: Theme.bg;
        border-radius: 14px;
        border-width: 1px;
        border-color: Theme.line;
    }

    // top: logo, name, buttons, status
    Image {
        x: root.compact ? 13px : 15px;
        y: 13px;
        width: root.compact ? 20px : 22px;
        height: self.width;
        source: @image-url("logo.svg");
    }

    title-t := Text {
        x: root.compact ? 41px : 44px;
        y: root.compact ? 14px : 15px;
        height: 18px;
        text: "Pulse";
        font-family: "Space Grotesk";
        font-size: root.compact ? 15px : 16px;
        font-weight: 700;
        color: Theme.ink;
        vertical-alignment: center;
    }

    IconBtn {
        x: root.close-x - 4px - 2 * root.ib;
        y: 9px;
        size: root.ib;
        source: root.compact ? @image-url("view-expanded.svg") : @image-url("view-compact.svg");
        label: root.compact ? "Switch to the expanded view" : "Switch to the compact view";
        on: !root.settings-open;
        clicked => {
            root.view-toggled();
        }
    }

    IconBtn {
        x: root.close-x - 2px - root.ib;
        y: 9px;
        size: root.ib;
        source: @image-url("settings.svg");
        label: "Settings";
        on: !root.settings-open;
        clicked => {
            root.settings-shown();
        }
    }

    IconBtn {
        x: root.close-x;
        y: 9px;
        size: root.ib;
        source: @image-url("close.svg");
        label: "Hide the panel";
        on: !root.settings-open;
        clicked => {
            root.close-clicked();
        }
    }

    // The status line (expanded view). The compact header has no room for it:
    // it names a warning in the warning colour, after the title, and says
    // nothing when all is well.
    if !root.compact: Rectangle {
        x: 15px;
        y: 46px;
        width: 8px;
        height: 8px;
        border-radius: 4px;
        background: root.status-warn ? Theme.warn : Theme.dot;
    }

    if !root.compact: Text {
        x: 30px;
        y: 41px;
        width: root.width - 30px - 14px;
        height: 19px;
        text: root.status;
        font-family: "Inter";
        font-size: 13px;
        color: Theme.mute;
        vertical-alignment: center;
        overflow: elide;
    }

    if root.compact && root.status-warn: Text {
        x: title-t.x + title-t.preferred-width + 10px;
        y: 14px;
        width: max(0px, root.close-x - 4px - 2 * root.ib - 8px - self.x);
        height: 18px;
        text: root.status;
        font-family: "Inter";
        font-size: 12.5px;
        font-weight: 500;
        color: Theme.warn;
        vertical-alignment: center;
        overflow: elide;
    }

    // tiles, expanded: B Tighter
    if !root.compact: Hero {
        x: 11px;
        y: 64px;
        label: "Processor";
        big: root.cpu-big;
        sub: root.cpu-sub;
        restart: root.cpu-restart;
        line: root.cpu-line;
        fill: root.cpu-fill;
        ink: Theme.neutral ? Theme.ink : Theme.hero-ink;
        tile-bg: Theme.neutral ? Theme.soft : Theme.hero-bg;
        spark: Theme.neutral ? Theme.c-cpu : Theme.hero-ink;
        square: Theme.neutral;
        outlined: Theme.neutral;
    }

    if !root.compact: Hero {
        x: 194px;
        y: 64px;
        label: "Memory";
        big: root.mem-big;
        sub: root.mem-sub;
        line: root.mem-line;
        fill: root.mem-fill;
        ink: Theme.ink;
        tile-bg: Theme.soft;
        spark: Theme.neutral ? Theme.c-mem : Theme.ink;
        square: Theme.neutral;
    }

    // tiles, compact: A Mini tiles
    if root.compact: MiniTile {
        x: 9px;
        y: 43px;
        label: "Processor";
        big: root.cpu-big;
        line: root.cpu-line;
        fill: root.cpu-fill;
        ink: Theme.neutral ? Theme.ink : Theme.hero-ink;
        tile-bg: Theme.neutral ? Theme.soft : Theme.hero-bg;
        spark: Theme.neutral ? Theme.c-cpu : Theme.hero-ink;
        square: Theme.neutral;
        outlined: Theme.neutral;
    }

    if root.compact: MiniTile {
        x: 194px;
        y: 43px;
        label: "Memory";
        big: root.mem-big;
        big-size: 19px;
        line: root.mem-line;
        fill: root.mem-fill;
        ink: Theme.ink;
        tile-bg: Theme.soft;
        spark: Theme.neutral ? Theme.c-mem : Theme.ink;
        square: Theme.neutral;
    }

    // top apps header
    Text {
        x: root.px;
        y: root.head-y + 8px;
        height: 14px;
        text: "Top apps";
        font-family: "Inter";
        font-size: root.compact ? 13px : 13.5px;
        font-weight: 600;
        color: Theme.ink;
        vertical-alignment: center;
    }

    Seg {
        x: root.width - root.px - self.width;
        y: root.head-y;
        dense: true;
        labels: ["Memory", "Processor"];
        current: root.sort-cpu ? 1 : 0;
        on: !root.settings-open;
        picked(i) => {
            root.sort-picked(i);
        }
    }

    // The list fills the space down to the tiles (or the footer) and scrolls when it does not fit.
    apps-scroll := Scroll {
        x: root.px;
        y: root.list-y;
        width: root.width - 2 * root.px;
        height: root.list-bottom - root.list-y;
        content-h: list.preferred-height;
        list := VerticalLayout {
            y: 0px;
            width: apps-scroll.width - (list.preferred-height > apps-scroll.height + 0.5px ? 8px : 0px);
            alignment: start;
            spacing: 0px;
            for item[i] in root.apps: AppRow {
                item: item;
                last: i == root.apps.length - 1;
                bar: root.bar;
                compact: root.compact;
                toggled => {
                    root.wsl-toggled();
                }
            }
        }
    }

    // bottom row of tiles (expanded)
    if !root.compact: Tile {
        x: 11px;
        y: root.tiles-y;
        width: 114px;
        k: "Graphics";
        v: root.gpu-big;
        s: root.gpu-missing ? "" : "3D engine";
        small-v: root.gpu-missing;
        bar: !root.gpu-missing;
        frac: root.gpu-frac;
        accent: Theme.c-gpu;
    }

    if !root.compact: Tile {
        x: 133px;
        y: root.tiles-y;
        width: 114px;
        k: "Drive C: free";
        v: root.drive-big;
        s: root.drive-sub;
        frac: root.drive-frac;
        accent: Theme.c-drive;
    }

    if !root.compact: Tile {
        x: 255px;
        y: root.tiles-y;
        width: 114px;
        k: "Network";
        v: root.net-big;
        s: root.net-sub;
        bar: false;
        accent: Theme.c-net;
    }

    if !root.compact && root.has-battery: Rectangle {
        x: 11px;
        y: root.height - 89px;
        width: 358px;
        height: 46px;
        border-radius: 12px;
        background: Theme.soft;
        Text {
            x: 9px;
            y: 4px;
            height: 19px;
            text: "Battery";
            font-family: "Inter";
            font-size: 13px;
            font-weight: 500;
            color: Theme.mute;
            vertical-alignment: center;
        }

        Text {
            x: 9px;
            y: 23px;
            height: 19px;
            text: root.bat-big;
            font-family: "Space Grotesk";
            font-size: 15.5px;
            font-weight: 700;
            color: Theme.ink;
            vertical-alignment: center;
        }

        Text {
            x: 72px;
            y: 23px;
            width: 140px;
            height: 19px;
            text: root.bat-sub;
            font-family: "Inter";
            font-size: 13px;
            color: Theme.mute;
            vertical-alignment: center;
            overflow: elide;
        }

        Rectangle {
            x: parent.width - 9px - 110px;
            y: 20.5px;
            width: 110px;
            height: 5px;
            border-radius: 3px;
            background: Theme.line;
            clip: true;
            Rectangle {
                x: 0;
                width: parent.width * root.bat-frac;
                height: parent.height;
                border-radius: 3px;
                background: root.bat-low ? Theme.warn : Theme.ink;
                animate width {
                    duration: Theme.motion;
                    easing: cubic-bezier(0.25, 0.1, 0.25, 1);
                }
            }
        }
    }

    // footer
    Rectangle {
        x: 1px;
        y: root.foot-y;
        width: root.width - 2px;
        height: 1px;
        background: Theme.line;
    }

    // footer, compact: small figures in one row (the battery has a second line)
    if root.compact: HorizontalLayout {
        x: 13px;
        y: root.foot-y + 7px;
        width: root.width - 26px;
        height: 17px;
        alignment: start;
        spacing: 10px;
        FootFig {
            pre: "Graphics";
            val: root.gpu-missing ? "n/a" : root.gpu-big;
            accent: Theme.c-gpu;
            square: true;
        }

        FootFig {
            pre: "C:";
            val: root.drive-big;
            post: "free";
            accent: Theme.c-drive;
            square: true;
        }

        FootFig {
            val: root.net-down;
            val2: root.net-up;
            accent: Theme.c-net;
            square: true;
        }
    }

    if root.compact && root.has-battery: FootFig {
        x: 13px;
        y: root.foot-y + 26px;
        pre: "Battery";
        val: root.bat-big;
        post: "· " + root.bat-sub;
        warn: root.bat-low;
    }

    // footer, expanded: the shortcut and the age of the reading
    if !root.compact && root.cap != "": Rectangle {
        x: 15px;
        y: root.foot-y + 8px;
        width: cap-measure.preferred-width + 12px;
        height: 18px;
        background: Theme.soft;
        border-radius: 5px;
        border-width: 1px;
        border-color: Theme.line;
        Text {
            y: 1px;
            height: 15px;
            text: root.cap;
            font-family: "Inter";
            font-size: 12.5px;
            font-weight: 600;
            color: Theme.ink;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    if !root.compact: Text {
        x: root.cap != "" ? 15px + cap-measure.preferred-width + 12px + 4px : 15px;
        y: root.foot-y + 7px;
        width: 262px - self.x;
        height: 19px;
        text: (root.cap != "" && foot-measure.preferred-width > self.width) ? root.foot-short : root.foot;
        font-family: "Inter";
        font-size: 13px;
        color: Theme.mute;
        vertical-alignment: center;
        overflow: elide;
    }

    if !root.compact: Text {
        x: 255px;
        y: root.foot-y + 7px;
        width: 110px;
        height: 19px;
        text: root.ago;
        font-family: "Inter";
        font-size: 13px;
        color: Theme.mute;
        horizontal-alignment: right;
        vertical-alignment: center;
    }

    // Width of the full sentence, to see whether it fits next to the key cap.
    foot-measure := Text {
        visible: false;
        text: root.foot;
        font-family: "Inter";
        font-size: 13px;
    }

    // Width of the key cap's text, for placing the words after it.
    cap-measure := Text {
        visible: false;
        text: root.cap;
        font-family: "Inter";
        font-size: 12.5px;
        font-weight: 600;
    }

    // The Settings screen, a layer over the whole panel.
    if root.settings-open: Rectangle {
        width: root.width;
        height: root.height;
        background: Theme.bg;
        border-radius: 14px;
        border-width: 1px;
        border-color: Theme.line;
        // Swallow clicks so nothing underneath reacts.
        TouchArea { }

        Text {
            x: 17px;
            y: 19px;
            height: 22px;
            text: "Settings";
            font-family: "Space Grotesk";
            font-size: 19px;
            font-weight: 700;
            color: Theme.ink;
            vertical-alignment: center;
        }

        sc := Scroll {
            x: 17px;
            y: 54px;
            width: root.width - 34px;
            height: root.height - 54px - 62px;
            content-h: rows.preferred-height;
            rows := VerticalLayout {
                y: 0px;
                width: sc.width - 10px;
                alignment: start;
                // Shown only after a save failed twice.
                if root.save-failed: Rectangle {
                    height: save-note.preferred-height + 22px;
                    save-note := Text {
                        x: 0;
                        y: 12px;
                        width: parent.width;
                        text: "Couldn't save settings. Changes will be lost when Pulse closes.";
                        wrap: word-wrap;
                        font-family: "Inter";
                        font-size: 13px;
                        font-weight: 600;
                        color: Theme.warn;
                    }

                    Rectangle {
                        y: parent.height - 1px;
                        height: 1px;
                        background: Theme.line;
                    }
                }
                // Shortcut: name and switch on one line, the field under it
                // (click it to record), then one line of help.
                Rectangle {
                    height: 8px + 24px + 6px + 34px + 6px + shortcut-note.preferred-height + 9px;
                    Text {
                        x: 0;
                        y: 8px;
                        width: parent.width - 52px;
                        height: 24px;
                        horizontal-alignment: left;
                        text: "Open and close shortcut";
                        font-family: "Inter";
                        font-size: 14px;
                        font-weight: 600;
                        color: Theme.ink;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    Rectangle {
                        x: parent.width - 40px;
                        y: 8px;
                        width: 40px;
                        height: 24px;
                        PSwitch {
                            checked: root.shortcut-on;
                            toggled(v) => {
                                root.shortcut-toggled(v);
                            }
                        }
                    }

                    field := Rectangle {
                        x: 0;
                        y: 38px;
                        width: parent.width;
                        height: 34px;
                        border-radius: 8px;
                        border-width: root.field-state == 2 ? 2px : 1px;
                        background: root.field-state == 2 ? (Theme.neutral ? Theme.soft : Theme.hero-bg) : (root.field-state == 3 ? Theme.warn.with-alpha(0.08) : (field-ta.has-hover ? Theme.line : Theme.soft));
                        border-color: root.field-state == 2 ? Theme.dot : (root.field-state == 3 ? Theme.warn : (field-ta.has-hover ? Theme.mute : Theme.line));
                        Text {
                            x: 12px;
                            width: parent.width - 24px - hint-t.preferred-width - 8px;
                            text: root.key-text;
                            font-family: "Inter";
                            font-size: 14px;
                            font-weight: 600;
                            color: root.field-state == 3 ? Theme.warn : (root.field-state == 1 ? Theme.mute : Theme.ink);
                            vertical-alignment: center;
                            overflow: elide;
                        }

                        hint-t := Text {
                            x: parent.width - self.preferred-width - 12px;
                            text: root.key-hint;
                            font-family: "Inter";
                            font-size: 12px;
                            color: Theme.mute;
                            vertical-alignment: center;
                        }

                        field-fs := FocusScope {
                            key-pressed(e) => {
                                if (e.text == " " || e.text == "\n") {
                                    root.field-clicked();
                                    return accept;
                                }
                                return reject;
                            }
                        }

                        field-ta := TouchArea {
                            clicked => {
                                root.field-clicked();
                            }
                        }

                        Ring {
                            active: field-fs.has-focus;
                        }
                    }

                    shortcut-note := Text {
                        x: 0;
                        y: 78px;
                        width: parent.width;
                        text: root.hotkey-note;
                        wrap: word-wrap;
                        font-family: "Inter";
                        font-size: 12.5px;
                        color: root.hotkey-warn ? Theme.warn : Theme.mute;
                    }

                    Rectangle {
                        y: parent.height - 1px;
                        height: 1px;
                        background: Theme.line;
                    }
                }

                SRow {
                    name: "Colours";
                    note: "Neutral: a colour per tile.";
                    ctl-w: 150px;
                    Seg {
                        labels: ["Mint", "Neutral"];
                        current: Theme.neutral ? 1 : 0;
                        picked(i) => {
                            root.theme-picked(i);
                        }
                    }
                }

                SRow {
                    name: "Keep open when I click away";
                    note: "Stays open until you press Esc or the x.";
                    PSwitch {
                        checked: root.keep-open;
                        toggled(v) => {
                            root.keep-toggled(v);
                        }
                    }
                }

                SRow {
                    name: "Start with Windows";
                    note: root.autostart-other ? "Another copy of Pulse starts with Windows." : "Opens in the tray when you sign in.";
                    PSwitch {
                        checked: root.autostart;
                        toggled(v) => {
                            root.autostart-toggled(v);
                        }
                    }
                }

                SRow {
                    name: "Refresh while hidden";
                    note: "Always 2 s while open.";
                    ctl-w: 136px;
                    Seg {
                        labels: ["2 s", "5 s", "10 s"];
                        current: root.refresh;
                        picked(i) => {
                            root.refresh-picked(i);
                        }
                    }
                }

                // About: the version, and Slint's own attribution widget (its
                // Royalty-free licence asks for it on an About screen), scaled down.
                Rectangle {
                    height: 62px;
                    Text {
                        x: 0;
                        y: 0;
                        width: parent.width - 150px;
                        height: parent.height;
                        horizontal-alignment: left;
                        text: "Pulse " + root.version + "\nLicences are in the install folder.";
                        font-family: "Inter";
                        font-size: 12px;
                        color: Theme.mute;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    Rectangle {
                        // The widget centres its logo in 128 px; push that box
                        // right so the logo ends near the switches' edge.
                        x: parent.width - 92px;
                        y: 4px;
                        width: 128px;
                        height: 54px;
                        clip: true;
                        AboutSlint {
                            x: 0;
                            y: 0;
                            width: 256px;
                            height: 108px;
                            transform-scale: 0.5;
                            transform-origin: { x: 0px, y: 0px };
                        }
                    }
                }
            }
        }

        PButton {
            x: 17px;
            y: root.height - 52px;
            width: root.width - 34px;
            height: 40px;
            text: "Done";
            primary: true;
            clicked => {
                root.settings-hidden();
            }
        }
    }
}
